{
  "name": "mailstrive",
  "version": "1.0.0",
  "private": true,
  "description": "Permission-based bulk email campaign platform (Next.js + Node.js + Amazon SES)",
  "workspaces": [
    "shared",
    "backend",
    "worker",
    "frontend"
  ],
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "npm run build --workspace @mailstrive/shared && npm run build --workspace @mailstrive/backend && npm run build --workspace @mailstrive/worker && npm run build --workspace @mailstrive/frontend",
    "build:server": "tsc -b shared backend worker",
    "dev": "concurrently -n api,worker,web -c blue,magenta,green \"npm:dev:api\" \"npm:dev:worker\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace @mailstrive/backend",
    "dev:worker": "npm run dev --workspace @mailstrive/worker",
    "dev:web": "npm run dev --workspace @mailstrive/frontend",
    "start:api": "npm run start --workspace @mailstrive/backend",
    "start:worker": "npm run start --workspace @mailstrive/worker",
    "verify": "npm run lint && npm run typecheck && npm run test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -b shared backend worker --pretty && tsc -p backend/tsconfig.test.json --pretty && npm run typecheck --workspace @mailstrive/frontend",
    "test": "npm run test --workspace @mailstrive/backend",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "prisma:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema prisma/schema.prisma",
    "seed": "tsx --env-file=.env prisma/seed.ts",
    "clean": "rimraf shared/dist backend/dist worker/dist frontend/.next **/*.tsbuildinfo"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.2",
    "concurrently": "^9.1.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "prisma": "^6.2.1",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.70.0"
  }
}
