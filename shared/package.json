    "@prisma/client": "^6.2.1",
    "bullmq": "^5.34.6",
    "ioredis": "^5.4.2",
    "nodemailer": "^10.0.10",
    "pino": "^9.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^6.4.24",
    "typescript": "^5.7.2"
