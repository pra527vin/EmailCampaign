{
  "name": "@mailstrive/shared",
  "version": "1.0.0",
  "private": true,
  "description": "Cross-cutting domain code shared by the API and the email worker.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
