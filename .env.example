# ---------------------------------------------------------------------------
# MailStrive — environment configuration
# Copy to `.env` and fill in. NEVER commit the real .env file.
# ---------------------------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=info

# --- API / HTTP -------------------------------------------------------------
API_PORT=4000
API_HOST=0.0.0.0
# Public origin of the Next.js frontend. Used for CORS, unsubscribe links and
# links rendered inside outgoing email.
APP_URL=http://localhost:3000
# Public origin of this API. Must be reachable by Amazon SNS for event webhooks.
API_PUBLIC_URL=http://localhost:4000

# --- Datastores -------------------------------------------------------------
DATABASE_URL=postgresql://mailstrive:mailstrive@localhost:5432/mailstrive?schema=public
REDIS_URL=redis://localhost:6379

# --- Auth -------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Session lifetime in seconds (default 12h)
SESSION_TTL_SECONDS=43200
# Cookie name + security flags
SESSION_COOKIE_NAME=mailstrive_session
# Set to true behind HTTPS in production
COOKIE_SECURE=false

# Secret used to sign one-click unsubscribe tokens (separate from AUTH_SECRET).
UNSUBSCRIBE_SECRET=change-me-to-another-long-random-string

# --- Amazon SES -------------------------------------------------------------
# The region must match where your identity is verified AND, for SMTP, where the
# SMTP credentials were created: SES SMTP passwords are derived per region and a
# password made in one region is rejected by every other with "535".
AWS_REGION=us-east-1

# How mail reaches SES: `api` (default) or `smtp`.
#
#   api   Signs each send with SigV4. Needs an IAM access key pair below.
#         The secret access key is exactly 40 characters.
#
#   smtp  Authenticates with SES SMTP credentials on port 587. These are NOT
#         an IAM key pair -- generate them under SES > SMTP settings, which
#         hands you a username (AKIA...) and a 44-character password together.
#         Use this when SMTP credentials are all you have.
#
# Mixing the two is the common mistake: an SMTP password used as
# AWS_SECRET_ACCESS_KEY fails with InvalidSignatureException.
SES_TRANSPORT=api

# For SES_TRANSPORT=api
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# For SES_TRANSPORT=smtp. Host defaults to email-smtp.<AWS_REGION>.amazonaws.com.
SES_SMTP_HOST=
SES_SMTP_PORT=587
SES_SMTP_USERNAME=
SES_SMTP_PASSWORD=

# Verified SES identity. Address or domain must be verified in the region above.
SES_FROM_EMAIL=campaigns@example.com
SES_FROM_NAME=Example Merchant Team
SES_REPLY_TO_EMAIL=support@example.com
# Optional: SES configuration set that publishes events to SNS.
SES_CONFIGURATION_SET=
# Max messages/second the worker may hand to SES. Keep <= your account quota.
SES_MAX_SEND_RATE=14
# Max messages/24h the account is allowed (used for quota awareness in the UI).
SES_DAILY_QUOTA=50000
# When true, no call is made to SES: messages are composed and marked sent but
# never delivered. Defaults to true so a fresh install runs end to end before
# AWS credentials exist. Set to false to send for real; boot refuses `true`
# when NODE_ENV=production.
SES_SANDBOX_DRY_RUN=true

# --- Worker -----------------------------------------------------------------
WORKER_CONCURRENCY=8
# Attempts per recipient before the send is marked permanently FAILED.
SEND_MAX_ATTEMPTS=3
SEND_BACKOFF_MS=5000
# Recipients enqueued per dispatch batch.
DISPATCH_BATCH_SIZE=500

# --- Uploads ----------------------------------------------------------------
UPLOAD_DIR=./uploads
# Max CSV upload size in bytes (default 25 MB)
MAX_UPLOAD_BYTES=26214400

# --- Rate limiting ----------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# --- Bootstrap admin (used by `npm run seed`) -------------------------------
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe!2026
SEED_ADMIN_NAME=Administrator

# --- Frontend (Next.js) -----------------------------------------------------
# Server-side origin the Next.js rewrite proxies /api/* to.
BACKEND_INTERNAL_URL=http://localhost:4000
